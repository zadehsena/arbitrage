# Copy this file to .env and fill in values locally. Never commit .env.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/Users/your-name/.secrets/kalshi-private-key.pem
# Alternative to the path above: one-line Base64 encoding of the complete PEM file.
KALSHI_PRIVATE_KEY_B64=

# Create these at https://polymarket.us/developer.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=
